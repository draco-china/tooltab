{
  "name": "tooltab",
  "private": true,
  "workspaces": [
    "apps/web",
    "packages/tools"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun run --cwd apps/web dev",
    "build": "bun run --cwd apps/web build",
    "start": "bun run --cwd apps/web start",
    "lint": "biome lint --error-on-warnings .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "bun run lint && bun run format:check",
    "typecheck": "tsc -b",
    "test": "node ./node_modules/vitest/vitest.mjs run",
    "test:coverage": "bun scripts/verify-core-coverage.ts --run",
    "validate": "bun run check && bun run typecheck && bun run test:coverage && bun run build",
    "hooks:install": "lefthook install",
    "commitlint": "commitlint",
    "release": "semantic-release"
  },
  "devDependencies": {
    "@babel/core": "8.0.1",
    "@biomejs/biome": "2.5.12",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@inlang/paraglide-js": "2.25.0",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/exec": "7.1.0",
    "@semantic-release/git": "11.0.1",
    "@semantic-release/github": "12.0.9",
    "@semantic-release/npm": "13.1.5",
    "@semantic-release/release-notes-generator": "14.1.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/bun": "1.3.14",
    "@types/figlet": "1.7.0",
    "@types/node": "26.4.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/sanitize-html": "2.16.1",
    "@types/turndown": "5.0.6",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-istanbul": "5.0.0",
    "@vitest/istanbul-lib-coverage": "1.0.0",
    "@vitest/istanbul-lib-instrument": "1.0.0",
    "@vitest/istanbul-lib-report": "1.0.0",
    "@vitest/istanbul-lib-source-maps": "1.0.0",
    "lefthook": "2.1.12",
    "rolldown": "1.2.7",
    "semantic-release": "25.0.9",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "5.0.0",
    "wrangler": "4.130.0"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "bun@1.3.14",
  "version": "0.0.0",
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  }
}
