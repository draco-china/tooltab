{
  "$schema": "https://biomejs.dev/schemas/2.5.12/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!!**/src/paraglide",
      "!!**/node_modules",
      "!!**/dist",
      "!!**/.output",
      "!!**/.output-coverage",
      "!!**/.nitro",
      "!!**/.tanstack",
      "!!**/coverage",
      "!!**/project.inlang/cache",
      "!!**/public/pdfjs-6.3.289",
      "!!**/public/licenses",
      "!!**/src/routeTree.gen.ts"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "jsxQuoteStyle": "double",
      "quoteProperties": "asNeeded",
      "trailingCommas": "all",
      "semicolons": "always",
      "arrowParentheses": "always",
      "bracketSameLine": false,
      "bracketSpacing": true
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "assist": {
    "enabled": false
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "useExhaustiveDependencies": "error",
        "useHookAtTopLevel": "error",
        "noUnusedVariables": {
          "level": "error",
          "options": {
            "ignoreRestSiblings": true
          }
        },
        "noUnusedFunctionParameters": {
          "level": "error",
          "options": {
            "ignoreRestSiblings": true
          }
        }
      },
      "suspicious": {
        "noArrayIndexKey": "error",
        "noImportCycles": "error",
        "noDoubleEquals": {
          "level": "error",
          "options": {
            "ignoreNull": true
          }
        }
      },
      "security": {
        "noDangerouslySetInnerHtml": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["apps/web/src/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "**/packages/tools/src/**",
                      "@workspace/tools/src/**"
                    ],
                    "message": "Import the tools library through its public package exports."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/tools/src/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@/**",
                      "@workspace/web",
                      "@workspace/web/**",
                      "react",
                      "react/**",
                      "react-dom",
                      "react-dom/**",
                      "**/apps/**"
                    ],
                    "message": "The tools library must not depend on application or React modules."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
